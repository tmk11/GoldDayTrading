# GoldDayTrading - example environment file
# Copy to `.env` and fill in only the providers you intend to use.

# ---- LLM providers (any one is enough; OpenAI is the default) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Model selection ----
# Used by Day Trader, Risk Manager, Bull/Bear debate (slower, sharper)
GDT_DEEP_LLM=gpt-4o
# Used by Technical / News / Sentiment / Session analysts (cheap, fast)
GDT_QUICK_LLM=gpt-4o-mini
# openai | anthropic | gemini | offline
GDT_LLM_PROVIDER=openai

# ---- Trading defaults ----
# Default ticker: XAUUSD=X (spot), GC=F (COMEX front-month), MGC=F (micro), GLD (ETF)
GDT_DEFAULT_TICKER=XAUUSD=X
# Default timeframe for the technical analyst (1m, 5m, 15m, 1h)
GDT_PRIMARY_TIMEFRAME=15m
# Account size in USD used by the Risk Manager for position sizing
GDT_ACCOUNT_USD=10000
# Max risk per trade as percentage of account (typical day-trading: 0.25%-1.0%)
GDT_RISK_PER_TRADE_PCT=0.5
# Max daily loss before the Risk Manager forces flat (percentage of account)
GDT_DAILY_LOSS_LIMIT_PCT=2.0

# ---- Optional: economic calendar (no key needed for the built-in scraper) ----
# Set to "0" to disable the economic-calendar lookup
GDT_ENABLE_ECON_CALENDAR=1
